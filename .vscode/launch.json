{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to OpenOCD", // 调试配置文件名
            "type": "cortex-debug", // 调用 cortex-debug 插件
            "request": "attach",
            "servertype": "external", // 此处 external 表示使用外部调试服务器 即需要先运行 tasks.json 中的 debug 任务
            "gdbTarget": "localhost:3333",
            "executable": "./build/Debug/CMake.elf",
            // 可选： "svdFile": "./目标芯片.svd" 观察寄存器值
            "cwd": "."
        }
    ]
}
